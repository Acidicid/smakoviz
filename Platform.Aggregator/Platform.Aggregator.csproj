<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Aggregator (Gateway Aggregation pattern): одна відповідь із даних кількох мікросервісів.
       Typed HttpClients → service discovery ("https+http://menu-api"), resilience і CorrelationId — зі ServiceDefaults.
       Посилається ЛИШЕ на ServiceDefaults (DTO сервісів — власні копії в Models/, без project reference на сервіси). -->

  <PropertyGroup>
    <UserSecretsId>smakoviz-aggregator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
