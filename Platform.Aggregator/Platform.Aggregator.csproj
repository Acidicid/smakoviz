<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Aggregator (Gateway Aggregation pattern): одна відповідь із даних кількох мікросервісів.
       Лаб. 05: typed HttpClients; Лаб. 06: gRPC-клієнти (основний транспорт) → service discovery ("https+http://menu-api"), resilience і CorrelationId — зі ServiceDefaults.
       Посилається ЛИШЕ на ServiceDefaults (DTO сервісів — власні копії в Models/, без project reference на сервіси). -->

  <PropertyGroup>
    <UserSecretsId>smakoviz-aggregator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Лаб. 06: gRPC-клієнти з DI (Grpc.Net.Client усередині), генерація коду з .proto, Redis для агрегованих відповідей -->
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.*" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ті самі .proto, що й у сервісах (одне джерело правди), але генерується лише КЛІЄНТ -->
    <Protobuf Include="..\Services\Delivery\Delivery.Api\Protos\delivery.proto" GrpcServices="Client" Link="Protos\delivery.proto" />
    <Protobuf Include="..\Services\Menu\Menu.Api\Protos\menu.proto" GrpcServices="Client" Link="Protos\menu.proto" />
    <Protobuf Include="..\Services\Reviews\Reviews.WebApi\Protos\reviews.proto" GrpcServices="Client" Link="Protos\reviews.proto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
