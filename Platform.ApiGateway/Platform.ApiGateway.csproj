<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- API Gateway (YARP): єдина точка входу http://localhost:5000.
       Маршрути — у appsettings.json (секція ReverseProxy), адреси сервісів — логічні імена Aspire
       (http://delivery-api), їх підставляє service discovery. Посилається ЛИШЕ на ServiceDefaults. -->

  <PropertyGroup>
    <UserSecretsId>smakoviz-api-gateway</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="9.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
