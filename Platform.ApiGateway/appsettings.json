{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "smakoviz-identity",
    "Audience": "smakoviz-platform",
    "SigningKey": "dev-only-signing-key-change-me-in-production-32+"
  },
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" },
        "Metadata": { "Team": "platform", "Version": "v1" }
      },
      "delivery": {
        "ClusterId": "delivery",
        "Order": 10,
        "Match": { "Path": "/api/delivery/{**catch-all}" },
        "Metadata": { "Team": "delivery", "Version": "v1" }
      },
      "menu": {
        "ClusterId": "menu",
        "Order": 10,
        "Match": { "Path": "/api/menu/{**catch-all}" },
        "Metadata": { "Team": "menu", "Version": "v1" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 10,
        "Match": { "Path": "/api/reviews/{**catch-all}" },
        "Metadata": { "Team": "reviews", "Version": "v1" }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "d1": { "Address": "http://aggregator" } }
      },
      "delivery": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://delivery-api" } }
      },
      "menu": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://menu-api" } }
      },
      "reviews": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "Destinations": { "d1": { "Address": "http://reviews-api" } }
      }
    }
  }
}
