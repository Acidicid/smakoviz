<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Aspire AppHost: описує ВСІ ресурси платформи (SQL Server, MongoDB, Delivery, Menu, Reviews, Aggregator, Gateway)
       і запускає їх однією командою (dotnet run у цій папці або F5 у Visual Studio).
       Потрібен запущений Docker Desktop: SQL Server стартує в контейнері. -->

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <!-- тут Aspire зберігає згенерований пароль SQL Server (user secrets) -->
    <UserSecretsId>smakoviz-platform-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.0" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="9.5.0" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="9.5.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Services\Delivery\Delivery.Api\Delivery.Api.csproj" />
    <ProjectReference Include="..\Services\Menu\Menu.Api\Menu.Api.csproj" />
    <ProjectReference Include="..\Services\Reviews\Reviews.WebApi\Reviews.WebApi.csproj" />
    <!-- Лаб. 05. ServiceDefaults — не ресурс (не запускається), лише спільна бібліотека -->
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\Platform.Aggregator\Platform.Aggregator.csproj" />
    <ProjectReference Include="..\Platform.ApiGateway\Platform.ApiGateway.csproj" />
  </ItemGroup>
</Project>
