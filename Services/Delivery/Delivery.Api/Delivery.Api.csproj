<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Web/API: контролери, middleware, налаштування хосту. Бачить лише BLL. -->

  <PropertyGroup>
    <!-- XML-коментарі контролерів потрапляють у Swagger -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>smakoviz-delivery-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.*" />
    <!-- Лаб. 06: gRPC-сервер + Redis через Aspire -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Delivery.Bll\Delivery.Bll.csproj" />
    <!-- Dal потрібен ЛИШЕ Program.cs (composition root): зареєструвати UnitOfWork у DI.
         Контролери працюють тільки з сервісами BLL і про репозиторії не знають. -->
    <ProjectReference Include="..\Delivery.Dal\Delivery.Dal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 05: Serilog, OpenTelemetry, health checks, service discovery — централізовано -->
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 06: контракт gRPC; Server — генерується DeliveryService.DeliveryServiceBase -->
    <Protobuf Include="Protos\delivery.proto" GrpcServices="Server" />
  </ItemGroup>
</Project>
