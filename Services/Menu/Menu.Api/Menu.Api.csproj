<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Web/API сервісу «Меню»: контролери, Program.cs, appsettings.json, Swagger, Serilog, Dockerfile. -->

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>smakoviz-menu-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.*" />
    <!-- Лаб. 06: gRPC-сервер (містить Google.Protobuf і Grpc.Tools) + Redis через Aspire -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
    <!-- Лаб. 07: стандартний gRPC Health Checking Protocol -->
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.71.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.*" />
    <!-- потрібен інструменту dotnet-ef у стартовому проєкті (міграції) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Menu.Bll\Menu.Bll.csproj" />
    <!-- Dal потрібен ЛИШЕ Program.cs (composition root): AddDbContext, UnitOfWork, міграції й сідінг.
         Контролери працюють тільки з сервісами BLL і DbContext не бачать. -->
    <ProjectReference Include="..\Menu.Dal\Menu.Dal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 05: Serilog, OpenTelemetry, health checks, service discovery — централізовано -->
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 06: контракт gRPC; Server — генерується базовий клас MenuService.MenuServiceBase -->
    <Protobuf Include="Protos\menu.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <!-- Лаб. 08: RabbitMQ — публікація подій страв і споживання OrderPlaced -->
    <ProjectReference Include="..\..\..\Platform.EventBus\Platform.EventBus.csproj" />
  </ItemGroup>
</Project>
